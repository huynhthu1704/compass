{
  "permissions": {
    "allow": [
      "Bash(curl * https://www.figma.com/api/mcp/asset/*)",
      "Bash(curl * \"https://www.figma.com/api/mcp/asset/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/compass/hooks/guard-edit.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
