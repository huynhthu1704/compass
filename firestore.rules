rules_version = '2';
// Compass team access (F-015, REQ-030 … REQ-046, ADR-010 … ADR-020).
// Publish: Firebase console → Firestore Database → Rules → paste this file → Publish.
// Tests: npm run test:rules (Firestore emulator). Keep gateRoles() equal to GATE_ROLES in src/team.ts.
// These rules guard Firestore data only. GitHub commits use the shared work token (ADR-016) and are not seen here;
// approvals without a matching record are flagged by the portal instead (ADR-012).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- who is asking -------------------------------------------------------------------------------------------
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }

    // SHA-256 of the super admin's lower-case Google email (ADR-013); the email itself is not in the repo.
    function superAdminHash() { return '937a5a56a92ff8e4b58a73b9110d6132d6e0f3fb75dc8ef4aa434664e4895677'; }
    function access() { return /databases/$(database)/documents/config/access; }
    function isSuperAdmin() { return signedIn() && exists(access()) && me() in get(access()).data.superAdmins; }
    // The owner: the account whose hashed email is above (ADR-013). Only the owner changes the super admin list (ADR-018).
    function isOwner() { return signedIn() && hashing.sha256(me()).toHexString().lower() == superAdminHash(); }

    // ---- people (REQ-041 AC3) --------------------------------------------------------------------------------------
    // people/{email}.projects lists the projects a person is on; it is written with each team change.
    function personPath(email) { return /databases/$(database)/documents/people/$(email); }
    function isPerson() { return signedIn() && exists(personPath(me())) && get(personPath(me())).data.projects.size() > 0; }

    // ---- projects --------------------------------------------------------------------------------------------------
    function projectPath(pid) { return /databases/$(database)/documents/projects/$(pid); }
    function baselinePath(pid) { return /databases/$(database)/documents/projects/$(pid)/baseline/initial; }
    function project(pid) { return get(projectPath(pid)).data; }
    function isMember(pid) { return signedIn() && exists(projectPath(pid)) && me() in project(pid).members; }
    function isAdmin(pid) { return isMember(pid) && me() in project(pid).admins; }
    // Admin lives only in `admins` (one source of truth); an 'Admin' entry in a team role list is ignored.
    function rolesOf(pid) { return project(pid).team.get(me(), []); }
    function canManage(pid) { return isSuperAdmin() || isAdmin(pid); }
    // A people/{email} write changes exactly one project: added while the project (after this write) lists the email,
    // removed once it no longer does, and only by that project's Admin or a super admin.
    function peopleChangeOk(email, before, after) {
      let added = after.removeAll(before);
      let removed = before.removeAll(after);
      return (added.size() == 1 && removed.size() == 0 && canManage(added[0])
                && email in getAfter(projectPath(added[0])).data.members)
        || (added.size() == 0 && removed.size() == 1 && canManage(removed[0])
                && !(email in getAfter(projectPath(removed[0])).data.members));
    }

    // Which roles may pass each gate (REQ-033). Must equal GATE_ROLES in src/team.ts.
    function gateRoles() {
      return {
        'intent': ['PO'],
        'requirements': ['PO', 'BA'],
        'design': ['UX', 'PO'],
        'tests': ['QA'],
        'build': ['Dev'],
        'release': ['DM', 'PO'],
        'team': ['Admin']
      };
    }

    // A team document: members, at least one Admin (REQ-031), every member has roles. Emails are stored lower-case by
    // the portal (src/team.ts); a mixed-case entry could never match me(), so it would only lock that person out.
    function validProject(d) {
      return d.keys().hasOnly(['name', 'repo', 'members', 'admins', 'team'])
        && d.members is list && d.admins is list && d.team is map
        && d.admins.size() > 0
        && d.members.hasAll(d.admins)
        && d.team.keys().hasOnly(d.members) && d.members.hasOnly(d.team.keys());
    }

    match /config/access {
      // Only a super admin may read it, so the plain email is never shown to other accounts (ADR-013).
      // isSuperAdmin() still works for everyone: get() inside rules is not limited by read rules.
      allow get: if signedIn() && resource != null && me() in resource.data.superAdmins;
      allow list: if false;
      // Created once, by the owner's own verified account (REQ-035, ADR-013). From then on only the owner changes the
      // list of super admins, and always stays in it (REQ-046, ADR-018).
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['superAdmins'])
        && request.resource.data.superAdmins == [me()];
      allow update: if isOwner()
        && request.resource.data.keys().hasOnly(['superAdmins'])
        && request.resource.data.superAdmins is list
        && me() in request.resource.data.superAdmins;
      allow delete: if false;
    }

    // The shared work token, Anthropic key and settings (REQ-041, REQ-044, ADR-016, ADR-017). Every reader's browser
    // can read the token and key: super admins and anyone on a team (people/{email}). Only super admins write them.
    match /config/workspace {
      allow get: if isSuperAdmin() || isPerson();
      allow list: if false;
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['workToken', 'anthropicKey', 'model', 'autoSync', 'newProjectsAccount']);
      allow delete: if isSuperAdmin();
    }

    match /people/{email} {
      allow get: if signedIn() && (me() == email || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if signedIn() && email == email.lower()
        && request.resource.data.keys().hasOnly(['projects'])
        && request.resource.data.projects is list
        && peopleChangeOk(email, resource == null ? [] : resource.data.projects, request.resource.data.projects);
      allow delete: if isSuperAdmin();
    }

    match /projects/{pid} {
      allow get: if isMember(pid) || isSuperAdmin();
      allow list: if isSuperAdmin() || (signedIn() && me() in resource.data.members);
      // Only the super admin creates a project's first team, together with its approval baseline (REQ-030, REQ-038).
      allow create: if isSuperAdmin() && validProject(request.resource.data) && existsAfter(baselinePath(pid));
      // Admins of the project or the super admin manage the team; the repo never changes (REQ-030, REQ-031, REQ-035).
      allow update: if (isAdmin(pid) || isSuperAdmin())
        && validProject(request.resource.data)
        && request.resource.data.repo == resource.data.repo;
      allow delete: if false;

      // The approvals already in spec.json when the team was created (REQ-038). Written once, never changed.
      match /baseline/{doc} {
        allow read: if isMember(pid) || isSuperAdmin();
        allow create: if doc == 'initial' && isSuperAdmin()
          && !exists(projectPath(pid)) && existsAfter(projectPath(pid))
          && request.resource.data.keys().hasOnly(['approvals']) && request.resource.data.approvals is list;
        allow update, delete: if false;
      }

      // One record per approval, written before the GitHub commit (REQ-037). Append-only.
      match /approvals/{rid} {
        allow read: if isMember(pid) || isSuperAdmin();
        allow create: if signedIn() && (isMember(pid) || isSuperAdmin())
          && request.resource.data.keys().hasOnly(['items', 'gate', 'email', 'role', 'at'])
          && request.resource.data.items is list && request.resource.data.items.size() > 0
          && request.resource.data.email == me()
          && request.resource.data.gate in gateRoles().keys() && request.resource.data.gate != 'team' // no record for team changes, so the 'Admin' role never signs one
          && request.resource.data.at == request.time
          && (
            (request.resource.data.role == 'super admin' && isSuperAdmin())
            || (isMember(pid)
                && request.resource.data.role in rolesOf(pid)
                && request.resource.data.role in gateRoles()[request.resource.data.gate])
          );
        allow update, delete: if false;
      }

      // Retired project tokens (REQ-043, ADR-016): nobody reads or writes them; a super admin deletes what remains.
      match /secrets/{doc} {
        allow read, create, update: if false;
        allow delete: if isSuperAdmin();
      }
    }
  }
}
